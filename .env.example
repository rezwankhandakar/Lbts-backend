# Port the API listens on. Render injects its own PORT in production.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string, including the database name.
# Atlas > Cluster > Connect > Drivers. Replace <db_password> with the real
# password (URL-encode any special characters).
DATABASE_URL=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/lbts?retryWrites=true&w=majority

# Origins allowed by CORS, comma-separated. The deployed Netlify URL in
# production. In development any http://localhost:<port> is accepted anyway,
# because Vite moves to the next free port when 5173 is taken.
CLIENT_ORIGIN=http://localhost:5173

# --- Firebase Admin service account ---------------------------------------
# Firebase Console > Project settings > Service accounts > Generate new
# private key. The downloaded JSON contains all three values below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the whole key on ONE line, keeping the literal \n sequences, wrapped
# in double quotes. The app converts them back into real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare R2 (profile photos) ----------------------------------------
# Profile photos are stored in a Cloudflare R2 bucket; MongoDB only holds the
# public URL and the object key. Cloudflare Dashboard > R2 > Overview.
#
# Optional: leave these blank and the API still boots and serves everything
# else — only the profile photo endpoints answer 503. All five must be set
# together, or none of them counts as set.
#
# R2_SECRET_ACCESS_KEY is server-side only. It must never be exposed to the
# browser or added to any VITE_ variable.

# R2 > Overview > the account id shown beside the S3 API endpoint.
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 > API > Manage API tokens > Create User API token, scoped "Object Read &
# Write" on this one bucket. The pair is shown once, at creation.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# The bucket name exactly as created.
R2_BUCKET=lbts-uploads

# How the browser reads an uploaded photo. R2 buckets are private by default,
# so this has to be turned on: bucket > Settings > Public access. Either enable
# the r2.dev development subdomain (fine for development, rate limited and not
# meant for production) or connect a custom domain. No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Key prefix every avatar is stored under. Optional; defaults to avatars.
R2_KEY_PREFIX=avatars

# Key prefix for scanned gate pass documents, kept separate from avatars so the
# two can be given different bucket lifecycle rules. Optional; defaults to
# gate-passes. Objects land at
#   <prefix>/<year>/<month>/<day>/<gate pass id>/<random>.<ext>
#
# Note that gate pass documents are NOT served from R2_PUBLIC_BASE_URL. They
# carry customer addresses, so the API streams them from the private bucket at
# GET /api/v1/gate-passes/:id/document behind the usual auth and role checks.
R2_GATE_PASS_PREFIX=gate-passes

# Key prefix for generated challan documents, kept separate again so the bucket
# can give them their own lifecycle rules. Optional; defaults to challans.
# Objects land at
#   <prefix>/<year>/<month>/<challan number>/<random>.pdf
#
# What is stored under here is only what an individual SUBMITTED challan
# became: its original front pages followed by the generated LBTS back page.
# The source WhatsApp PDF an operator works from is never uploaded anywhere -
# it is a temporary working document held in the browser. Like gate pass
# documents these are NOT served from R2_PUBLIC_BASE_URL; a challan carries a
# customer's home address, so the API streams it from the private bucket at
# GET /api/v1/challans/:id/document behind the usual auth and role checks.
R2_CHALLAN_PREFIX=challans

# --- Gemini (assistive location resolution) --------------------------------
# The Challan module resolves a delivery's District and Thana against the
# Location Master collection in MongoDB. That collection is the source of
# truth. Gemini is only ever asked to CHOOSE between candidate rows this API
# has already shortlisted - it cannot invent a district, a thana or a location
# type, and every answer it gives is re-checked against the collection before
# anything is written.
#
# Optional. Leave GEMINI_API_KEY blank and the API still boots and files
# challans exactly as before; resolution simply stops at the local matcher and
# anything it could not settle is left blank for an administrator to correct.
# An unresolved location NEVER blocks a challan submission.
#
# Server-side only. This key must never be exposed to the browser or copied
# into any VITE_ variable - the browser asks this API to resolve a location,
# and this API is what talks to Gemini.
#
# Google AI Studio > Get API key.
GEMINI_API_KEY=

# Which model answers. Optional; defaults to gemini-2.5-flash, which is the
# right size for "pick one of these twelve rows".
GEMINI_MODEL=gemini-2.5-flash

# How sure Gemini has to be before its choice is written to a challan, 0-1.
# Optional; defaults to 0.85. Anything below it leaves the location blank for
# an administrator, which is deliberately the preferred outcome: a blank
# location is always better than a wrong one. The resolver applies a hard floor
# of 0.7 regardless of what is set here.
GEMINI_CONFIDENCE=0.85

# How long to wait for an answer, in milliseconds. Optional; defaults to 8000.
# Short on purpose - this runs while an operator is waiting to submit, and the
# correct response to a slow model is to leave the location blank and carry on.
GEMINI_TIMEOUT_MS=8000
